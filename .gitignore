# Reference projects cloned for study (see winamp-skin-player-brief.md)
/References/

# Local skins and audio; never commit third-party assets
/Skins/
*.wsz
*.wal
*.mp3
# The generated test tones (#0195); scripts/check-fixtures.sh keeps audio out of everywhere else.
!Packages/PlayerKit/Sources/PlayerKitTestFixtures/Audio/*.mp3

# Generated by XcodeGen (`xcodegen generate`)
*.xcodeproj/

# Build output
.build/
.swiftpm/
DerivedData/
build/
xcuserdata/

.DS_Store

# Xcode removes Package.resolved from local packages; the app project owns resolution
/Packages/*/Package.resolved

# Downloaded skins
Skins/

# Environment
.env


# Python bytecode
__pycache__/
*.pyc

# Release DMGs live on GitHub releases and, once deployed, on the web host; never in git.
website/downloads/*.dmg
